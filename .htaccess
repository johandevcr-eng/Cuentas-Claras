# Habilitar compresión gzip
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Cachés del navegador
<IfModule mod_expires.c>
  ExpiresActive On
  
  # Imágenes (30 días)
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/gif "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  
  # CSS y JS (30 días)
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType text/javascript "access plus 30 days"
  
  # Fuentes (30 días)
  ExpiresByType application/x-font-ttf "access plus 30 days"
  ExpiresByType application/x-font-otf "access plus 30 days"
  ExpiresByType application/x-font-woff "access plus 30 days"
  ExpiresByType application/x-font-woff2 "access plus 30 days"
  
  # HTML (1 día)
  ExpiresByType text/html "access plus 1 day"
  ExpiresByType application/xhtml+xml "access plus 1 day"
</IfModule>

# Headers para seguridad y rendimiento
<IfModule mod_headers.c>
  Header set X-UA-Compatible "IE=edge"
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  
  # Permitir fuentes desde Google Fonts
  Header set Access-Control-Allow-Origin "*" "expr=%{CONTENT_TYPE} =~ m#font#"
</IfModule>

# Reescrituras amigables
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Redirigir HTTP a HTTPS (descomentar si tiene SSL)
  # RewriteCond %{HTTPS} off
  # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  
  # Evitar acceso directo a archivos sensibles
  RewriteRule ^\.git - [F,L]
  RewriteRule ^\.env - [F,L]
</IfModule>

# Denegar acceso a directorios
<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>
